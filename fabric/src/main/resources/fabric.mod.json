{
	"schemaVersion": 1,
	"id": "${mod_id}",
	"version": "${version}",
	"name": "${mod_name}",
	"description": "${description}",
	"authors": [
		"${mod_author}"
	],
	"contributors": [
		"${contributors}"
	],
	"contact": {
		"homepage": "${link_home}",
		"sources": "${link_src}",
		"issues": "${link_issues}"
	},
	"license": "${license}",
	"icon": "icon.png",
	"environment": "*",
	"depends": {
		"fabricloader": ">=${fabric_loader_version}",
		"minecraft": "${fabric_compatible_range}"
	}
}
